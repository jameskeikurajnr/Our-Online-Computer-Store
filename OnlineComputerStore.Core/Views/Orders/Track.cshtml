@{
    ViewData["Title"] = "Track Order";
}
<style>
    /* Scoped to this page. Reuses the site's real theme tokens
       (--brand-teal/--card-bg/--text-primary/etc from site.css) the same
       way Login/Contact already do. */

    .track-wrap { max-width: 480px; margin: 0 auto; }
    .track-eyebrow {
        color: var(--brand-teal); background: var(--ai-panel-bg); border: 1px solid var(--ai-panel-border);
        display: inline-flex; padding: 5px 14px; border-radius: 999px;
        font-size: 11.5px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; margin-bottom: 14px;
    }
    .track-hero { text-align: center; margin-bottom: 28px; }
    .track-hero h1 { font-size: 26px; font-weight: 700; margin: 0 0 8px; color: var(--text-primary); }
    .track-hero p { color: var(--text-muted); font-size: 14.5px; margin: 0; }

    .track-card {
        background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--card-radius);
        box-shadow: 0 20px 45px -28px rgba(20,33,61,.35), 0 2px 10px rgba(20,33,61,.06);
        padding: 32px;
    }

    /* Styles the framework-generated validation summary (a <div><ul><li></ul></div> —
       asp-validation-summary controls the messages, not the markup) to match the
       same warning-alert look used on Contact. */
    .validation-summary-errors {
        display: flex; gap: 10px; align-items: flex-start;
        background: #fff8ec; border: 1px solid #f5dfb3; color: #8a5a00;
        padding: 12px 14px; border-radius: 10px; font-size: 13.5px; margin-bottom: 20px;
    }
    [data-theme="dark"] .validation-summary-errors { background: rgba(249,115,22,.12); border-color: rgba(249,115,22,.3); color: #ffc98a; }
    .validation-summary-errors::before {
        content: ""; flex: none; width: 16px; height: 16px; margin-top: 1px;
        background: currentColor;
        -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M12 9v4'/><path d='M12 17h.01'/><path d='M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z'/></svg>") center / contain no-repeat;
        mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M12 9v4'/><path d='M12 17h.01'/><path d='M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z'/></svg>") center / contain no-repeat;
    }
    .validation-summary-errors ul { list-style: none; margin: 0; padding: 0; }
    .validation-summary-valid { display: none; }

    .track-field { margin-bottom: 18px; }
    .track-field label { display: block; font-size: 13px; font-weight: 600; color: var(--text-primary); margin-bottom: 7px; }
    .track-input-wrap { position: relative; display: flex; align-items: center; }
    .track-input-wrap svg.f-icon { position: absolute; left: 14px; color: var(--text-muted); pointer-events: none; }
    .track-input-wrap input {
        width: 100%; padding: 12px 14px 12px 42px; border-radius: 10px;
        border: 1.5px solid var(--input-border); font-size: 14.5px;
        background: var(--input-bg); color: var(--text-primary);
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .track-input-wrap input:focus {
        outline: none; border-color: var(--brand-teal);
        box-shadow: 0 0 0 4px rgba(20,184,166,.15);
    }

    .btn-track {
        width: 100%; border: none; padding: 13px 18px; border-radius: 10px;
        font-size: 15px; font-weight: 700; color: #04221d;
        background: linear-gradient(135deg, #1fd6bf, var(--brand-teal));
        box-shadow: 0 10px 22px -8px rgba(20,184,166,.55); cursor: pointer;
    }
    .btn-track:hover { color: #04221d; filter: brightness(1.03); }

    .track-help { text-align: center; font-size: 12.5px; color: var(--text-muted); margin: 18px 0 0; }
</style>

<div class="container my-5">
    <div class="track-wrap">
        <div class="track-hero">
            <span class="track-eyebrow">Order Lookup</span>
            <h1>Track Your Order</h1>
            <p>Enter your order ID and the email used at checkout.</p>
        </div>

        <div class="track-card">
            <div asp-validation-summary="All"></div>

            <form asp-action="Track" method="post">
                <div class="track-field">
                    <label>Order ID</label>
                    <div class="track-input-wrap">
                        <svg class="f-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9" /><line x1="4" y1="15" x2="20" y2="15" /><line x1="10" y1="3" x2="8" y2="21" /><line x1="16" y1="3" x2="14" y2="21" /></svg>
                        <input name="orderId" type="number" placeholder="e.g. 1042" required />
                    </div>
                </div>
                <div class="track-field">
                    <label>Email used at checkout</label>
                    <div class="track-input-wrap">
                        <svg class="f-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 6 9 7 9-7" /><rect x="3" y="5" width="18" height="14" rx="2" /></svg>
                        <input name="email" type="email" placeholder="you@@example.com" required />
                    </div>
                </div>
                <button type="submit" class="btn-track">Track Order</button>
            </form>
            <p class="track-help">Your order ID was included in your confirmation email.</p>
        </div>
    </div>
</div>
