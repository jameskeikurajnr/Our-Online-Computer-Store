@{
    ViewData["Title"] = "Track Order";
}
<div class="container my-5" style="max-width:500px">
    <h1 class="section-title">Track Your Order</h1>
    <div asp-validation-summary="All" class="text-danger"></div>
    <form asp-action="Track" method="post" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label class="form-label">Order ID</label>
            <input name="orderId" type="number" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Email used at checkout</label>
            <input name="email" type="email" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-cta btn-lg w-100">Track</button>
    </form>
</div>
