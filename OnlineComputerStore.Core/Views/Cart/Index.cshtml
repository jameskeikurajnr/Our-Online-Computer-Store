@model Cart
@{
    ViewData["Title"] = "Cart";
}
<div class="container my-5">
    <h1 class="section-title">Cart</h1>

    @if (!Model.Items.Any())
    {
        <p class="text-muted">Empty.</p>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Continue Shopping</a>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <table class="table align-middle">
                    <thead>
                        <tr><th>Product</th><th>Qty</th><th>Price</th><th>Subtotal</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="d-flex align-items-center gap-2">
                                    <img src="@item.Product.ImageUrl" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:8px" />
                                    @item.Product.Name
                                </td>
                                <td style="max-width:90px">
                                    <form asp-action="UpdateQuantity" method="post" class="d-flex">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" onchange="this.form.submit()" />
                                    </form>
                                </td>
                                <td>@item.Product.Price.ToMoney()</td>
                                <td>@((item.Product.Price * item.Quantity).ToMoney())</td>
                                <td>
                                    <form asp-action="Remove" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <form asp-action="Clear" method="post">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Clear Cart</button>
                </form>
            </div>
            <div class="col-lg-4">
                <div class="summary-panel">
                    <h5>Order Summary</h5>
                    <div class="d-flex justify-content-between"><span>Subtotal</span><strong>@Model.Total.ToMoney()</strong></div>
                    <div class="d-flex justify-content-between text-muted small"><span>Shipping</span><span>Calculated at checkout</span></div>
                    <hr />
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-cta w-100 btn-lg">Proceed to Checkout</a>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-link w-100">Continue shopping</a>
                </div>
            </div>
        </div>
    }
</div>
