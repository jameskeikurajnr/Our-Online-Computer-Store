@model IEnumerable<Product>
@{
    ViewData["Title"] = "Admin — Products";
}
<style>
    /* Scoped to this page — reuses the site's existing theme tokens from site.css
       so the table, pills and buttons all stay correct under the global
       light/dark toggle, matching the treatment already shipped on
       Login/Register/Dashboard. */
    .products-eyebrow {
        color: var(--brand-teal);
        background: var(--ai-panel-bg);
        border: 1px solid var(--ai-panel-border);
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    :root {
        --stock-danger: #dc3545;
        --stock-warning: var(--brand-cta);
        --stock-success: #16a34a;
    }
    [data-theme="dark"] {
        --stock-success: #22c55e;
    }

    .products-header { margin-bottom: 24px; }
    .products-header h1 { font-size: 28px; margin: 0 0 6px; font-weight: 700; color: var(--text-primary); }
    .products-header .sub { color: var(--text-muted); font-size: 14px; margin: 0; }

    .panel {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--card-radius);
        box-shadow: 0 10px 24px -18px rgba(20,33,61,.25);
        overflow: hidden;
    }

    table.products-table { width: 100%; border-collapse: collapse; margin: 0; }
    .products-table thead th {
        text-align: left;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        color: var(--text-muted);
        padding: 16px 20px;
        border-bottom: 1px solid var(--card-border);
        background: var(--track-bg);
    }
    .products-table tbody td {
        padding: 16px 20px;
        border-bottom: 1px solid var(--card-border);
        vertical-align: middle;
        font-size: 13.5px;
    }
    .products-table tbody tr:last-child td { border-bottom: none; }
    .products-table tbody tr:hover { background: var(--track-bg); }

    .prod-cell { display: flex; align-items: center; gap: 12px; min-width: 220px; }
    .prod-thumb {
        width: 44px; height: 44px; border-radius: 10px; flex: none;
        background: var(--track-bg); overflow: hidden;
        display: flex; align-items: center; justify-content: center;
        color: var(--text-muted);
    }
    .prod-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .prod-name { font-weight: 600; color: var(--text-primary); }
    .prod-brand { font-size: 12px; color: var(--text-muted); margin-top: 2px; }

    .category-chip {
        display: inline-flex; font-size: 11.5px; font-weight: 600;
        color: var(--text-muted); background: var(--track-bg);
        padding: 3px 9px; border-radius: 999px;
    }

    .price-cell { font-weight: 700; color: var(--text-primary); white-space: nowrap; }

    .stock-pill {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 11.5px; font-weight: 700;
        padding: 4px 10px; border-radius: 999px;
        white-space: nowrap; margin-bottom: 8px;
    }
    .stock-pill .dot { width: 6px; height: 6px; border-radius: 50%; }
    .stock-pill.out { background: rgba(220,53,69,.12); color: var(--stock-danger); }
    .stock-pill.low { background: rgba(249,115,22,.12); color: var(--stock-warning); }
    .stock-pill.in { background: rgba(22,163,74,.12); color: var(--stock-success); }

    .stock-form { display: flex; align-items: center; gap: 6px; }
    .stock-stepper {
        display: flex; align-items: center;
        border: 1.5px solid var(--input-border);
        border-radius: 8px; overflow: hidden;
        background: var(--input-bg);
    }
    .stock-stepper button {
        width: 26px; height: 30px; border: none; background: transparent;
        color: var(--text-muted); font-size: 15px; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        font-family: inherit;
    }
    .stock-stepper button:hover { color: var(--brand-teal); }
    .stock-stepper input {
        width: 44px; border: none; text-align: center; font-size: 13px;
        background: transparent; color: var(--text-primary);
        -moz-appearance: textfield;
    }
    .stock-stepper input::-webkit-outer-spin-button,
    .stock-stepper input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .stock-stepper input:focus { outline: none; }

    .btn-pill {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 7px 14px; border-radius: 999px;
        font-size: 12.5px; font-weight: 600;
        font-family: inherit;
        border: 1.5px solid var(--card-border);
        background: var(--track-bg); color: var(--text-primary);
        cursor: pointer; white-space: nowrap;
        transition: border-color .15s ease;
        appearance: none;
        -webkit-appearance: none;
    }
    .btn-pill:hover { border-color: var(--brand-teal); }
    .btn-pill.ai {
        background: linear-gradient(135deg, #1fd6bf, var(--brand-teal));
        border-color: transparent; color: #04221d;
    }
    .btn-pill.ai:hover { filter: brightness(1.04); color: #04221d; }

    .desc-cell {
        max-width: 260px; color: var(--text-muted); font-size: 12.5px;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .empty-row { color: var(--text-muted); font-size: 13.5px; padding: 20px; margin: 0; }

    .scroll-hint { display: none; }

    @@media (max-width: 900px) {
        .products-table { display: block; overflow-x: auto; white-space: nowrap; }
        .desc-cell { white-space: normal; }
        .scroll-hint {
            display: block; font-size: 12px; color: var(--text-muted);
            margin: -8px 0 10px; text-align: right;
        }
    }
</style>

<div class="container my-5">
    <div class="products-header">
        <span class="products-eyebrow">Admin</span>
        <h1>Products</h1>
        <p class="sub">Manage stock levels and generate AI-written descriptions for your catalog.</p>
    </div>

    <p class="scroll-hint">Swipe to see more &rarr;</p>

    <div class="panel">
        @if (!Model.Any())
        {
            <p class="empty-row">No products yet.</p>
        }
        else
        {
            <table class="products-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Description</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <div class="prod-cell">
                                    <div class="prod-thumb">
                                        @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                                        {
                                            <img src="@p.ImageUrl" alt="" />
                                        }
                                        else
                                        {
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-5-5L5 21" /></svg>
                                        }
                                    </div>
                                    <div>
                                        <div class="prod-name">@p.Name</div>
                                        <div class="prod-brand">@p.Brand</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="category-chip">@p.Category</span></td>
                            <td class="price-cell">@p.Price.ToMoney()</td>
                            <td style="min-width:170px">
                                @if (p.StockQuantity <= 0)
                                {
                                    <span class="stock-pill out"><span class="dot" style="background:var(--stock-danger);"></span>Out of stock</span>
                                }
                                else if (p.StockQuantity <= 5)
                                {
                                    <span class="stock-pill low"><span class="dot" style="background:var(--stock-warning);"></span>Low: @p.StockQuantity left</span>
                                }
                                else
                                {
                                    <span class="stock-pill in"><span class="dot" style="background:var(--stock-success);"></span>@p.StockQuantity in stock</span>
                                }
                                <form asp-action="UpdateStock" asp-route-id="@p.Id" method="post" class="stock-form">
                                    <div class="stock-stepper">
                                        <button type="button" class="stepper-dec" aria-label="Decrease quantity">&minus;</button>
                                        <input type="number" name="quantity" value="@p.StockQuantity" min="0" />
                                        <button type="button" class="stepper-inc" aria-label="Increase quantity">+</button>
                                    </div>
                                    <button type="submit" class="btn-pill">Update</button>
                                </form>
                            </td>
                            <td class="desc-cell">@p.Description</td>
                            <td>
                                <form asp-action="GenerateDescription" asp-route-id="@p.Id" method="post">
                                    <button type="submit" class="btn-pill ai">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.5 5.5L19 9l-5.5 1.5L12 16l-1.5-5.5L5 9l5.5-1.5z" /></svg>
                                        AI Description
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Event delegation so this keeps working regardless of how many
            // product rows the table renders, without wiring a handler per row.
            document.addEventListener('click', function (e) {
                var btn = e.target.closest('.stepper-dec, .stepper-inc');
                if (!btn) return;

                var input = btn.parentElement.querySelector('input[name="quantity"]');
                if (!input) return;

                var value = parseInt(input.value, 10);
                if (isNaN(value)) value = 0;

                value += btn.classList.contains('stepper-inc') ? 1 : -1;
                if (value < 0) value = 0;

                input.value = value;
            });
        })();
    </script>
}
