@model IEnumerable<Order>
@{
    ViewData["Title"] = "Admin — Orders";
    var statuses = (string[])ViewBag.Statuses;
    var statusFilter = (string?)ViewBag.StatusFilter;

    // Same four fulfillment statuses AdminController.ValidStatuses restricts orders
    // to; "other" is only a safety net in case that list ever changes without this
    // view being updated too (mirrors the same helper pattern on the Dashboard).
    string StatusClass(string status) => status switch
    {
        "Processing" => "processing",
        "Shipped" => "shipped",
        "Delivered" => "delivered",
        "Cancelled" => "cancelled",
        _ => "other"
    };

    string StatusColorVar(string status) => status switch
    {
        "Processing" => "var(--status-processing)",
        "Shipped" => "var(--status-shipped)",
        "Delivered" => "var(--status-delivered)",
        "Cancelled" => "var(--status-cancelled)",
        _ => "var(--text-muted)"
    };
}
<style>
    /* Scoped to this page — reuses the site's existing theme tokens from site.css
       so the table, pills and buttons all stay correct under the global
       light/dark toggle, matching Products/Dashboard. */
    .orders-eyebrow {
        color: var(--brand-teal);
        background: var(--ai-panel-bg);
        border: 1px solid var(--ai-panel-border);
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    :root {
        --status-processing: var(--brand-cta);
        --status-shipped: var(--brand-teal);
        --status-delivered: #16a34a;
        --status-cancelled: #dc3545;
    }
    [data-theme="dark"] {
        --status-delivered: #22c55e;
    }

    .orders-header { margin-bottom: 24px; }
    .orders-header h1 { font-size: 28px; margin: 0 0 6px; font-weight: 700; color: var(--text-primary); }
    .orders-header .sub { color: var(--text-muted); font-size: 14px; margin: 0; }

    .toolbar { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
    .filter-label { font-size: 12.5px; font-weight: 600; color: var(--text-muted); }

    .pill-select, .btn-pill {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 14px; border-radius: 999px;
        font-size: 13px; font-weight: 600;
        font-family: inherit;
        border: 1.5px solid var(--card-border);
        background: var(--card-bg); color: var(--text-primary);
        cursor: pointer; white-space: nowrap;
        text-decoration: none;
        transition: border-color .15s ease;
        appearance: none; -webkit-appearance: none;
    }
    .pill-select {
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path d='M1 1l4 4 4-4' stroke='%236c757d' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>");
        background-repeat: no-repeat;
        background-position: right 12px center;
        padding-right: 30px;
    }
    .pill-select:hover, .btn-pill:hover { border-color: var(--brand-teal); text-decoration: none; color: var(--text-primary); }
    .btn-pill.primary {
        background: linear-gradient(135deg, #1fd6bf, var(--brand-teal));
        border-color: transparent; color: #04221d;
    }
    .btn-pill.primary:hover { color: #04221d; filter: brightness(1.03); }
    .toolbar .spacer { margin-left: auto; }
    .filter-form { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; width: 100%; }

    .panel {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--card-radius);
        box-shadow: 0 10px 24px -18px rgba(20,33,61,.25);
        overflow: hidden;
    }

    /* Always scrollable, not just below some viewport threshold — the
       table's natural width (9 columns) is wider than Bootstrap's own
       .container at most laptop widths (it caps at 1140px below the xxl
       breakpoint), so gating this behind a media query let the panel's
       rounded-corner overflow:hidden silently clip the rightmost column
       instead of scrolling to it. */
    .table-scroll { overflow-x: auto; }
    table.orders-table { width: 100%; border-collapse: collapse; }
    .orders-table thead th {
        text-align: left;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        color: var(--text-muted);
        padding: 16px 18px;
        border-bottom: 1px solid var(--card-border);
        background: var(--track-bg);
    }
    .orders-table tbody td {
        padding: 14px 18px;
        border-bottom: 1px solid var(--card-border);
        vertical-align: middle;
        font-size: 13px;
    }
    .orders-table tbody tr:last-child td { border-bottom: none; }
    .orders-table tbody tr:hover { background: var(--track-bg); }
    .orders-table td:first-child { min-width: 110px; }

    .order-num { font-weight: 700; color: var(--text-primary); font-size: 13.5px; white-space: nowrap; }
    .order-customer { font-size: 12px; color: var(--text-muted); margin-top: 2px; white-space: nowrap; }

    .muted-cell { color: var(--text-muted); font-size: 12.5px; }
    .items-cell {
        max-width: 200px; color: var(--text-muted); font-size: 12.5px;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .total-cell { font-weight: 700; color: var(--text-primary); white-space: nowrap; }

    .payment-provider { font-weight: 600; color: var(--text-primary); font-size: 12.5px; }
    .payment-status { font-size: 11.5px; color: var(--text-muted); margin-top: 1px; }

    .fulfillment-chip {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 11.5px; font-weight: 600;
        padding: 4px 10px; border-radius: 999px;
        white-space: nowrap;
    }
    .fulfillment-chip.pickup { background: rgba(20,184,166,.12); color: var(--brand-teal); }
    .fulfillment-chip.ship { background: var(--track-bg); color: var(--text-muted); }

    .status-pill {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 11.5px; font-weight: 700;
        padding: 4px 10px; border-radius: 999px;
        white-space: nowrap;
    }
    .status-pill .dot { width: 6px; height: 6px; border-radius: 50%; }
    .status-pill.processing { background: rgba(249,115,22,.12); color: var(--status-processing); }
    .status-pill.shipped { background: rgba(20,184,166,.12); color: var(--status-shipped); }
    .status-pill.delivered { background: rgba(22,163,74,.12); color: var(--status-delivered); }
    .status-pill.cancelled { background: rgba(220,53,69,.12); color: var(--status-cancelled); }
    .status-pill.other { background: var(--track-bg); color: var(--text-primary); }

    .status-form { display: flex; align-items: center; gap: 6px; }
    /* The status pill just to the left already shows the current word in full —
       this control is only for picking a new one, so it collapses down to just
       the chevron rather than repeating the same text a second time. The value
       is still there (and still reachable/readable) the moment the native
       dropdown opens; text-indent only hides it in the closed, collapsed state. */
    .status-form select {
        width: 34px;
        overflow: hidden;
        text-indent: -9999px;
        font-size: 12px; font-family: inherit; font-weight: 600;
        padding: 6px 8px; border-radius: 8px;
        border: 1.5px solid var(--input-border);
        background: var(--input-bg); color: var(--text-primary);
        cursor: pointer;
        appearance: none; -webkit-appearance: none;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path d='M1 1l4 4 4-4' stroke='%236c757d' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>");
        background-repeat: no-repeat;
        background-position: center;
    }
    .status-form .btn-pill {
        padding: 6px 12px; font-size: 12px; background: var(--track-bg); border-color: transparent;
    }
    .status-form .btn-pill:hover { border-color: var(--brand-teal); }

    .empty-row { color: var(--text-muted); font-size: 13.5px; padding: 20px; margin: 0; }

    .orders-table { white-space: nowrap; }
    .items-cell { white-space: normal; }

    .scroll-hint { display: none; }

    @@media (max-width: 1080px) {
        /* The scrollbar itself is enough of a cue on desktop (mouse/trackpad
           users see it immediately); touch devices don't show one until
           mid-scroll, so only they get the explicit hint text. */
        .scroll-hint {
            display: block; font-size: 12px; color: var(--text-muted);
            margin: -8px 0 10px; text-align: right;
        }
    }
</style>

<div class="container my-5">
    <div class="orders-header">
        <span class="orders-eyebrow">Admin</span>
        <h1>Orders</h1>
        <p class="sub">Track fulfillment and update order status.</p>
    </div>

    <div class="toolbar">
        <form method="get" class="filter-form">
            <span class="filter-label">Filter by status</span>
            <select name="status" class="pill-select" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(statusFilter))">All</option>
                @foreach (var s in statuses)
                {
                    <option value="@s" selected="@(s == statusFilter)">@s</option>
                }
            </select>
            <a asp-action="ExportOrdersCsv" asp-route-status="@statusFilter" class="btn-pill primary spacer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v13m0 0-4-4m4 4 4-4" /><path d="M4 17v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" /></svg>
                Export CSV
            </a>
        </form>
    </div>

    <p class="scroll-hint">Swipe to see more &rarr;</p>

    <div class="panel">
        @if (!Model.Any())
        {
            <p class="empty-row">No orders found.</p>
        }
        else
        {
            <div class="table-scroll">
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Email</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Fulfillment</th>
                        <th>Placed</th>
                        <th>Status</th>
                        <th>Update</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td>
                                <div class="order-num">#@o.Id</div>
                                <div class="order-customer">@o.CustomerName</div>
                            </td>
                            <td class="muted-cell">@o.Email</td>
                            <td class="items-cell">@string.Join(", ", o.Items.Select(i => $"{i.ProductName} x{i.Quantity}"))</td>
                            <td class="total-cell">@o.Total.ToMoney()</td>
                            <td>
                                <div class="payment-provider">@o.PaymentProvider</div>
                                <div class="payment-status">@o.PaymentStatus</div>
                            </td>
                            <td>
                                @if (o.FulfillmentMethod == "Pickup")
                                {
                                    <span class="fulfillment-chip pickup">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V8l9-5 9 5v13" /><path d="M9 21v-6h6v6" /></svg>
                                        @o.PickupLocation
                                    </span>
                                }
                                else
                                {
                                    <span class="fulfillment-chip ship">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" /><path d="M16 8h4l3 3v5h-7V8z" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
                                        Ship
                                    </span>
                                }
                            </td>
                            <td class="muted-cell">@o.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                            <td><span class="status-pill @StatusClass(o.Status)"><span class="dot" style="background:@StatusColorVar(o.Status);"></span>@o.Status</span></td>
                            <td>
                                <form asp-action="UpdateOrderStatus" asp-route-id="@o.Id" method="post" class="status-form">
                                    <select name="status" title="Change status" aria-label="Change status">
                                        @foreach (var s in statuses)
                                        {
                                            <option value="@s" selected="@(s == o.Status)">@s</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn-pill">Update</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
</div>
