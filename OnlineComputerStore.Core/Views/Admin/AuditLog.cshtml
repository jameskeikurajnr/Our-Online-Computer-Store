@model IEnumerable<AuditLogEntry>
@{
    ViewData["Title"] = "Admin — Audit Log";
}

<div class="container my-5">

    <h1 class="section-title">Admin: Audit Log</h1>

    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <p class="text-muted mb-0">
            My Admin Activity — Newest to Latest.
        </p>

        @if (Model.Any())
        {
            <div class="d-flex flex-wrap gap-2 align-items-center">

                <!-- Clear by Days -->
                <form asp-action="ClearAuditLogByDays" method="post"
                      class="d-flex gap-2 align-items-center"
                      onsubmit="return confirm('Delete all entries older than the specified number of days?');">

                    <label class="visually-hidden" for="clearDays">Older than (days)</label>
                    <input id="clearDays" type="number" name="days" min="1" value="30"
                           class="form-control form-control-sm" style="width:90px"
                           title="Older than (days)" />

                    <button type="submit" class="btn btn-light btn-sm d-flex align-items-center gap-1">
                        <i class="bi bi-calendar-minus" aria-hidden="true"></i>
                        By Days
                    </button>
                </form>

                <!-- Clear by Month -->
                <form asp-action="ClearAuditLogByMonth" method="post"
                      class="d-flex gap-2 align-items-center"
                      onsubmit="return confirm('Delete all entries from the selected month?');">

                    <label class="visually-hidden" for="clearMonth">Month</label>
                    <input id="clearMonth" type="month" name="month"
                           class="form-control form-control-sm" style="width:160px" required />

                    <button type="submit" class="btn btn-light btn-sm d-flex align-items-center gap-1">
                        <i class="bi bi-calendar" aria-hidden="true"></i>
                        By Month
                    </button>
                </form>

                <!-- Clear All -->
                <form asp-action="ClearAuditLog" method="post"
                      onsubmit="return confirm('Permanently delete the entire log?');">

                    <button type="submit" class="btn btn-danger btn-sm d-flex align-items-center gap-1">
                        <i class="bi bi-trash" aria-hidden="true"></i>
                        Clear All
                    </button>
                </form>

            </div>

        }
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">No admin actions have been logged yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>Admin</th>
                        <th>Action</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="small text-muted">
                                @e.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                            </td>
                            <td>@e.AdminName</td>
                            <td>@e.Action</td>
                            <td class="small">@e.Details</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
