@model IEnumerable<ProductRequest>
@{
    ViewData["Title"] = "Admin: Not on Website";
}
<style>
    /* Scoped to this page — reuses the site's existing theme tokens from site.css
       so the table, pills and buttons all stay correct under the global
       light/dark toggle, matching Products/Orders/Dashboard. */
    .requests-eyebrow {
        color: var(--brand-teal);
        background: var(--ai-panel-bg);
        border: 1px solid var(--ai-panel-border);
        display: inline-flex;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    :root {
        --requests-danger: #dc3545;
        --requests-warning: var(--brand-cta);
        --requests-success: #16a34a;
    }
    [data-theme="dark"] {
        --requests-success: #22c55e;
    }

    .requests-header { margin-bottom: 24px; }
    .requests-header h1 { font-size: 28px; margin: 0 0 6px; font-weight: 700; color: var(--text-primary); }
    .requests-header .sub { color: var(--text-muted); font-size: 14px; margin: 0; }

    .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
    .toolbar .note { color: var(--text-muted); font-size: 13px; margin: 0; }

    .btn-pill {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 14px; border-radius: 999px;
        font-size: 13px; font-weight: 600;
        font-family: inherit;
        border: 1.5px solid var(--card-border);
        background: var(--card-bg); color: var(--text-primary);
        cursor: pointer; white-space: nowrap;
        transition: border-color .15s ease, background-color .15s ease;
        appearance: none; -webkit-appearance: none;
    }
    .btn-pill.danger {
        background: var(--requests-danger); border-color: var(--requests-danger); color: #fff;
    }
    .btn-pill.danger:hover { background: #c82333; border-color: #c82333; }
    .btn-pill.success {
        background: transparent; border-color: var(--requests-success); color: var(--requests-success);
    }
    .btn-pill.success:hover { background: rgba(22,163,74,.1); }

    .panel {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--card-radius);
        box-shadow: 0 10px 24px -18px rgba(20,33,61,.25);
        overflow: hidden;
    }

    /* Always scrollable (not gated behind a media query) — a fixed layout here
       would risk the same silent clipping the Orders table hit against
       Bootstrap's own .container width on ordinary desktop screens. */
    .table-scroll { overflow-x: auto; }
    table.requests-table { width: 100%; border-collapse: collapse; }
    .requests-table thead th {
        text-align: left;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        color: var(--text-muted);
        padding: 16px 20px;
        border-bottom: 1px solid var(--card-border);
        background: var(--track-bg);
        white-space: nowrap;
    }
    .requests-table tbody td {
        padding: 14px 20px;
        border-bottom: 1px solid var(--card-border);
        vertical-align: middle;
        font-size: 13.5px;
        white-space: nowrap;
    }
    .requests-table tbody tr:last-child td { border-bottom: none; }
    .requests-table tbody tr:hover { background: var(--track-bg); }

    .search-term { font-weight: 600; color: var(--text-primary); }

    .count-pill {
        display: inline-flex; align-items: center; gap: 4px;
        font-size: 11.5px; font-weight: 700;
        padding: 4px 10px; border-radius: 999px;
        white-space: nowrap;
    }
    .count-pill.alert { background: rgba(249,115,22,.12); color: var(--requests-warning); }
    .count-pill.notice { background: var(--track-bg); color: var(--text-muted); }
    .count-plain { color: var(--text-muted); font-size: 12.5px; }

    .date-cell { color: var(--text-muted); font-size: 12.5px; }

    .empty-row { color: var(--text-muted); font-size: 13.5px; padding: 24px; margin: 0; text-align: center; }

    .scroll-hint { display: none; }
    @@media (max-width: 700px) {
        .scroll-hint {
            display: block; font-size: 12px; color: var(--text-muted);
            margin: -8px 0 10px; text-align: right;
        }
    }
</style>

<div class="container my-5">
    <div class="requests-header">
        <span class="requests-eyebrow">Admin</span>
        <h1>Not on Website</h1>
        <p class="sub">Searches that came up empty more than twice — newest first.</p>
    </div>

    <div class="toolbar">
        <p class="note">@Model.Count() unresolved search@(Model.Count() == 1 ? "" : "es")</p>

        @if (Model.Any())
        {
            <form asp-action="ClearProductRequests" method="post"
                  onsubmit="return confirm('This will permanently delete every request on this list.');">
                <button type="submit" class="btn-pill danger">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16Z" /></svg>
                    Clear All
                </button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="panel">
            <p class="empty-row">No unmatched searches right now.</p>
        </div>
    }
    else
    {
        <p class="scroll-hint">Swipe to see more &rarr;</p>

        <div class="panel">
            <div class="table-scroll">
            <table class="requests-table">
                <thead>
                    <tr>
                        <th>Searched for</th>
                        <th>Times searched</th>
                        <th>First seen</th>
                        <th>Last seen</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="search-term">@r.SearchTerm</td>
                            <td>
                                @if (r.TimesSearched > 3)
                                {
                                    <span class="count-pill alert" title="Admin will be emailed once this crossed 3 searches">@r.TimesSearched&times;</span>
                                }
                                else if (r.TimesSearched > 2)
                                {
                                    <span class="count-pill notice">@r.TimesSearched&times;</span>
                                }
                                else
                                {
                                    <span class="count-plain">@r.TimesSearched</span>
                                }
                            </td>
                            <td class="date-cell">@r.FirstSearchedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                            <td class="date-cell">@r.LastSearchedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                            <td>
                                <form asp-action="ResolveProductRequest" asp-route-id="@r.Id" method="post">
                                    <button type="submit" class="btn-pill success" title="Mark as sourced/added">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                                        Handle Under Control
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }
</div>
