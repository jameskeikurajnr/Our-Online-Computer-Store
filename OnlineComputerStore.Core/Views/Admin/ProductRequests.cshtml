@model IEnumerable<ProductRequest>
@{
    ViewData["Title"] = "Admin: Not on Website";
}

<div class="container my-5">

    <h1 class="section-title">Admin: Not on Website</h1>

    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <p class="text-muted mb-0">
            Item searched for more than 2 times we don't carry — Newest first.
        </p>

        @if (Model.Any())
        {
            <form asp-action="ClearProductRequests" method="post"
                  onsubmit="return confirm('This will permanently delete every request on this list.');">
                <button type="submit" class="btn btn-danger btn-sm d-flex align-items-center gap-1">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                    Clear All
                </button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">No unmatched searches right now.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Searched for</th>
                        <th>Times searched</th>
                        <th>First seen</th>
                        <th>Last seen</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@r.SearchTerm</td>
                            <td>
                                @if (r.TimesSearched > 3)
                                {
                                    <span class="badge text-bg-warning" title="Admin will be emailed once this crossed 3 searches">@r.TimesSearched&times;</span>
                                }
                                else if (r.TimesSearched > 2)
                                {
                                    <span class="badge text-bg-secondary">@r.TimesSearched&times;</span>
                                }
                                else
                                {
                                    <span class="text-muted small">2</span>
                                }
                            </td>
                            <td class="small text-muted">@r.FirstSearchedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                            <td class="small text-muted">@r.LastSearchedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                            <td>
                                <form asp-action="ResolveProductRequest" asp-route-id="@r.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Mark as sourced/added">
                                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                                        Handled
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
