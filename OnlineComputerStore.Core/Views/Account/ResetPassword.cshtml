@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}
<div class="container my-5" style="max-width:420px">
    <h1 class="section-title">Reset Password</h1>
    <div asp-validation-summary="All" class="text-danger"></div>
    <form asp-action="ResetPassword" method="post" class="card p-4 shadow-sm">
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="Email" />
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-cta btn-lg w-100">Reset Password</button>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
