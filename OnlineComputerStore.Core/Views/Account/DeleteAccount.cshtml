@model DeleteAccountViewModel
@{
    ViewData["Title"] = "Delete Account";
}
<div class="container my-5" style="max-width:420px">
    <h1 class="section-title text-danger">Delete Your Account</h1>
    <p class="text-muted">This will permanently delete your account. This can't be undone. Your past orders will remain in our records but will no longer be linked to an account.</p>
    <div asp-validation-summary="All" class="text-danger"></div>
    <form asp-action="DeleteAccount" method="post" class="card p-4 shadow-sm border-danger">
        <div class="mb-4">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-danger btn-lg w-100">Yes, permanently delete account</button>
        <a asp-action="ManageAccount" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}