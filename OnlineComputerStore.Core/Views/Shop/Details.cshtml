@model Product
@{
    ViewData["Title"] = Model.Name;
    var reviews = (List<ProductReview>)ViewBag.Reviews;
    double ratingAverage = ViewBag.RatingAverage;
    int ratingCount = ViewBag.RatingCount;
    bool hasReviewed = ViewBag.HasReviewed;
    bool inWishlist = ViewBag.InWishlist;
    var frequentlyBought = (List<Product>)ViewBag.FrequentlyBoughtTogether;
    var setupBundle = (List<Product>)ViewBag.SetupBundle;
}
<div class="container my-5">
    <div class="row g-5">
        <div class="col-md-6">
            <img src="@Model.ImageUrl" class="img-fluid rounded-4 shadow-sm" alt="@Model.Name" />
        </div>
        <div class="col-md-6">
            <div class="d-flex justify-content-between align-items-start">
                <p class="text-muted mb-1">@Model.Brand · @Model.Category</p>
                @if (User.Identity!.IsAuthenticated)
                {
                    <form asp-controller="Wishlist" asp-action="Toggle" method="post">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                            @(inWishlist ? "♥ In " : "♡ Add ")
                        </button>
                    </form>
                }
            </div>
            <h1>@Model.Name</h1>
            <p class="text-muted">@Model.ShortSpecs</p>

            @if (ratingCount > 0)
            {
                <p class="mb-2"><span class="text-warning">@(new string('★', (int)Math.Round(ratingAverage)))@(new string('☆', 5 - (int)Math.Round(ratingAverage)))</span> <span class="text-muted small">@ratingAverage.ToString("0.0") / 5 · @ratingCount review@(ratingCount == 1 ? "" : "s")</span></p>
            }

            @if (Model.StockQuantity <= 0)
            {
                <span class="badge text-bg-danger mb-2">Out of Stock</span>
            }
            else if (Model.StockQuantity <= 5)
            {
                <span class="badge text-bg-warning mb-2">Only @Model.StockQuantity left</span>
            }
            else
            {
                <span class="badge text-bg-success mb-2">In Stock</span>
            }

            <h3 class="fw-bold text-cta">@Model.Price.ToMoney()</h3>
            <p>@Model.Description</p>

            <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2 mb-4">
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="number" name="quantity" value="1" min="1" max="@Model.StockQuantity" class="form-control" style="max-width:100px" disabled="@(Model.StockQuantity <= 0)" />
                <button type="submit" class="btn btn-cta btn-lg flex-grow-1" disabled="@(Model.StockQuantity <= 0)">@(Model.StockQuantity <= 0 ? "Out of Stock" : "Add to Cart")</button>
            </form>

            <div class="ai-panel">
                <h6 class="text-teal text-uppercase small mb-2">Recommended Accessories &amp; Upgrades (AI)</h6>
                <p class="mb-0">@ViewBag.Upsell</p>
            </div>

            @if (setupBundle != null && setupBundle.Any())
            {
                <div class="setup-bundle mt-4">
                    <h6 class="text-uppercase small text-teal mb-1">✨ Complete Your Setup</h6>
                    <p class="text-muted small mb-3">Pair your @Model.Name with the essentials — secure it, power it, back it up.</p>
                    <form asp-controller="Cart" asp-action="AddMultiple" method="post">
                        <input type="hidden" name="productIds" value="@Model.Id" />
                        <div class="d-flex flex-column gap-2 mb-3">
                            @foreach (var item in setupBundle)
                            {
                                <label class="setup-bundle-item d-flex align-items-center gap-3">
                                    <input type="checkbox" name="productIds" value="@item.Id" checked class="form-check-input flex-shrink-0" />
                                    <img src="@item.ImageUrl" alt="@item.Name" />
                                    <span class="flex-grow-1">
                                        <span class="d-block fw-semibold">@item.Name</span>
                                        <span class="d-block text-muted small">@item.Category</span>
                                    </span>
                                    <span class="fw-bold">@item.Price.ToMoney()</span>
                                </label>
                            }
                        </div>
                        <button type="submit" class="btn btn-cta w-100">Add Selected to Cart</button>
                    </form>
                </div>
            }

            @if (frequentlyBought != null && frequentlyBought.Any())
            {
                <div class="mt-4">
                    <h6 class="text-uppercase small text-muted mb-2">Customers who bought this also bought</h6>
                    <div class="d-flex gap-3 flex-wrap">
                        @foreach (var p in frequentlyBought)
                        {
                            <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-reset" style="width:110px">
                                <img src="@p.ImageUrl" class="img-fluid rounded mb-1" style="height:80px;object-fit:cover;width:100%" alt="@p.Name" />
                                <p class="small mb-0 text-truncate">@p.Name</p>
                                <p class="small fw-bold text-cta mb-0">@p.Price.ToMoney()</p>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <hr class="my-5" />
    <div class="row">
        <div class="col-md-8">
            <h3 class="section-title">Customer Reviews</h3>

            @if (reviews.Count == 0)
            {
                <p class="text-muted">No reviews yet — be the first!</p>
            }
            else
            {
                @foreach (var r in reviews)
                {
                    <div class="review-item mb-3 pb-3 border-bottom">
                        <div class="d-flex justify-content-between">
                            <strong>@r.UserName</strong>
                            <span class="text-warning">@(new string('★', r.Rating))@(new string('☆', 5 - r.Rating))</span>
                        </div>
                        <p class="text-muted small mb-1">@r.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</p>
                        <p class="mb-0">@r.Comment</p>
                    </div>
                }
            }

            @if (User.Identity!.IsAuthenticated)
            {
                @if (!hasReviewed)
                {
                    @if (TempData["ReviewError"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ReviewError"]</div>
                    }
                    <form asp-action="AddReview" method="post" class="mt-4">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <div class="mb-2">
                            <label class="form-label">Your rating</label>
                            <select name="rating" class="form-select" style="max-width:180px">
                                <option value="5">★★★★★ Excellent</option>
                                <option value="4">★★★★☆ Good</option>
                                <option value="3">★★★☆☆ Average</option>
                                <option value="2">★★☆☆☆ Poor</option>
                                <option value="1">★☆☆☆☆ Terrible</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <textarea name="comment" class="form-control" rows="3" placeholder="Share your thoughts on this product..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-cta">Submit Review</button>
                    </form>
                }
                else
                {
                    <p class="text-muted mt-4"><em>You've already reviewed this product — thanks!</em></p>
                }
            }
            else
            {
                <p class="text-muted mt-4"><a asp-controller="Account" asp-action="Login">Log in</a> to leave a review.</p>
            }
        </div>
    </div>
</div>
