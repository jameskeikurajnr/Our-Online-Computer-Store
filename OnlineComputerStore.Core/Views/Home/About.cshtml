@{
    ViewData["Title"] = "About Us";
}

<section class="hero d-flex align-items-center justify-content-center text-center" style="min-height: 260px;">
    <div class="hero-overlay"></div>
    <div class="container position-relative text-white py-5">
        <h1 class="mb-3 fw-bold">About Online Computer Store</h1>
        <p class="lead mb-0">
            Straightforward advice, honest prices, and genuine computers
            that actually fit the way you use them.
        </p>
    </div>
</section>

<div class="container my-5">
    <div class="row g-5 align-items-center mb-5">
        <div class="col-lg-7">
            <h2 class="section-title">Our story</h2>
            <p>
                Our Online Computer Store began as a single shopfront built on one simple belief: buying a
                computer shouldn't feel like guesswork. What started as a small, person&#8209;to&#8209;person
                operation has grown into a full online store offering laptops, desktops, monitors, and
                accessories from brands people genuinely trust, all while keeping the same human approach
                we began with.
            </p>
            <p>
                Every product we stock is something our team has used, tested, or would confidently recommend
                to a friend. And we've built the site to behave the way a good store should: AI&#8209;assisted
                search and comparison tools that help you find the right fit without drowning in spec sheets,
                real order tracking with a dedicated number for every purchase, and a real person reading
                every message sent through our Contact page, not a form that disappears into nowhere.
            </p>
            <p class="text-muted small mb-0">

            </p>
        </div>
        <div class="col-lg-5">
            <img src="/images/store-showroom.jpg" class="img-fluid rounded shadow-sm" alt="Our showroom" />
        </div>
    </div>

    <div class="row g-4 text-center value-strip py-4 mb-5">
        <div class="col-md-4">
            <span class="value-icon">🛠️</span>
            <h6 class="mb-1">Our Expert-Tested Picks</h6>
            <p class="text-muted small mb-0">Every product is vetted before it's placed on the shelf.</p>
        </div>
        <div class="col-md-4">
            <span class="value-icon">🤝</span>
            <h6 class="mb-1">Real People, Real Help, Original Products</h6>
            <p class="text-muted small mb-0">AI tools for speed, a human team for anything trickier.</p>
        </div>
        <div class="col-md-4">
            <span class="value-icon">🚚</span>
            <h6 class="mb-1">Backed After The Sale</h6>
            <p class="text-muted small mb-0">Order tracking, warranty support, and no disappearing act.</p>
        </div>
    </div>

</div>

<div class="ai-panel-flush text-center">
    <h6 class="text-teal text-uppercase small">Curious to know more?</h6>
    <p class="mb-3">Reach out any time. We'd genuinely like to hear from you.</p>
    <a asp-controller="Home" asp-action="Contact" class="btn btn-cta">Get in touch</a>
</div>
