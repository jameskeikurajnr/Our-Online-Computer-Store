@model VerifyEmailViewModel
@{
    ViewData["Title"] = "Verify your email";
}
<div class="container my-5" style="max-width:480px">
    <h1 class="section-title">Verify your email</h1>
    <p class="text-muted">Before you check out, we need to confirm the email address your order will be placed under. We'll send a 6-digit code to it.</p>
    <div asp-validation-summary="All" class="text-danger"></div>
    <form asp-action="VerifyEmail" method="post" class="card p-4 shadow-sm">
        <div class="mb-4">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-cta btn-lg w-100">Send verification code</button>
    </form>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
