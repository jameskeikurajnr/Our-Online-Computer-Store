@{
    ViewData["Title"] = "Payment Not Confirmed";
}
<div class="container my-5 text-center" style="max-width:600px">
    <span class="display-4">⚠️</span>
    <h1>Please we couldn't confirm your payment</h1>
    <p class="text-muted">@ViewBag.Message</p>
    @if (ViewBag.SessionId != null)
    {
        <p class="small text-muted">Reference: <code>@ViewBag.SessionId</code></p>
    }
    <div class="mt-3">
        <a asp-controller="Checkout" asp-action="Index" class="btn btn-cta">Return to Checkout</a>
        <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-primary">Contact Us</a>
    </div>
</div>

// Card number: 4242 4242 4242 4242
// Expiry: Any future date (10/27)
// CVC: Any 3 digits (123)
// Name/country: Any Name and Country