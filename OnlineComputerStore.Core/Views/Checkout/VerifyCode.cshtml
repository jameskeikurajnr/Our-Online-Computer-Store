@model VerifyCodeViewModel
@{
    ViewData["Title"] = "Enter verification code";
}
<div class="container my-5" style="max-width:480px">
    <h1 class="section-title">Enter verification code</h1>
    <p class="text-muted">We've sent a 6-digit code to <strong>@ViewBag.Email</strong>. Enter it below to continue to checkout.</p>
    <div asp-validation-summary="All" class="text-danger"></div>
    @if (ViewBag.StatusMessage != null)
    {
        <div class="alert alert-success">@ViewBag.StatusMessage</div>
    }
    <form asp-action="VerifyCode" method="post" class="card p-4 shadow-sm">
        <div class="mb-4">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" autofocus autocomplete="one-time-code" inputmode="numeric" maxlength="6" />
            <span asp-validation-for="Code" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-cta btn-lg w-100">Verify and continue</button>
    </form>
    <form asp-action="ResendCode" method="post" class="mt-3 text-center">
        <button type="submit" class="btn btn-link">Resend code</button>
    </form>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
