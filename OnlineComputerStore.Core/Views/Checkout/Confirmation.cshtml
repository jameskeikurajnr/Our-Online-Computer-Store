@model Order
@{
    ViewData["Title"] = "Order Confirmation";
}
<div class="container my-5" style="max-width:600px">
    <div class="text-center mb-4">
        <span class="display-4">✅</span>
        <h1>Thank you, @Model.CustomerName!</h1>
        <p class="text-muted">Your order <strong>#@Model.Id</strong> has been placed and is now @Model.Status.ToLower().</p>
        @if (Model.PaymentProvider == "Stripe")
        {
            <span class="badge bg-success">Paid via Stripe</span>
        }
        @if (Model.FulfillmentMethod == "Pickup")
        {
            <p class="mt-2 mb-0">🏬 You'll collect this order in-store at <strong>@Model.PickupLocation</strong> — we'll email you as soon as it's ready. God Bless You</p>
        }
        else
        {
            <p class="mt-2 mb-0">🚚 Shipping to: @Model.Address</p>
        }
    </div>
    <div class="card p-4">
        <h5>Order Summary</h5>
        <ul class="list-group list-group-flush mb-3">
            @foreach (var item in Model.Items)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@item.ProductName &times; @item.Quantity</span>
                    <span>@((item.UnitPrice * item.Quantity).ToMoney())</span>
                </li>
            }
        </ul>
        <div class="d-flex justify-content-between fs-5 fw-bold">
            <span>Total</span><span>@Model.Total.ToMoney()</span>
        </div>
    </div>
    <div class="text-center mt-4">
        <a asp-controller="Orders" asp-action="Track" class="btn btn-outline-primary">Track This Order</a>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-cta">Continue Shopping</a>
    </div>
</div>
