@{
    ViewData["Title"] = "Payment Cancelled";
}
<div class="container my-5 text-center" style="max-width:600px">
    <span class="display-4">🛒</span>
    <h1>Payment cancelled</h1>
    <p class="text-muted">No charge was made. Your cart is still saved, so you can pick up right where you left off.</p>
    <a asp-controller="Checkout" asp-action="Index" class="btn btn-cta btn-lg mt-3">Return to Checkout</a>
</div>
