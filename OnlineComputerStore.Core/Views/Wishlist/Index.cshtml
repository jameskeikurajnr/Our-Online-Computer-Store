@model IEnumerable<Product>
@{
    ViewData["Title"] = "Wishlist";
}
<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="section-title mb-0">Wishlist</h1>
        @if (Model.Any())
        {
            <form asp-controller="Wishlist" asp-action="Clear" method="post">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Clear</button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">You haven't saved anything yet. Browse the <a asp-controller="Shop" asp-action="Index">shop</a> and tap the heart on anything you like.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var p in Model)
            {
                <div class="col-md-3">
                    <div class="card product-card h-100">
                        <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="wishlist-toggle-form">
                            <input type="hidden" name="productId" value="@p.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="wishlist-heart-btn active" title="Remove">♥</button>
                        </form>
                        <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name" />
                        <div class="card-body d-flex flex-column">
                            <span class="badge text-bg-light mb-2 align-self-start">@p.Category</span>
                            <h5 class="card-title">@p.Name</h5>
                            <p class="card-text text-muted small">@p.ShortSpecs</p>
                            <p class="card-text fw-bold mt-auto">@p.Price.ToMoney()</p>
                            <a asp-controller="Shop" asp-action="Details" asp-route-id="@p.Id" class="btn btn-primary w-100">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
