<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Online Computer Store</title>
    <script>
        // Applied before the stylesheets load so there's no flash of the wrong
        // theme on page load. Respects a saved choice first, then falls back to
        // the OS-level preference if the person hasn't picked one on this site yet.
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                var wantsDark = saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
                if (wantsDark) document.documentElement.setAttribute('data-theme', 'dark');
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/assistant.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">OCS</span>Online Computer Store
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index">Shop</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Orders" asp-action="Track">Track Order</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About Us</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-admin dropdown-toggle" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
                                    Admin
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminMenu">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Orders">Orders</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Products">Products</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="AuditLog">Audit Log</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <form class="d-flex ai-search" asp-controller="Search" asp-action="Index" method="get" role="search">
                        <input class="form-control" type="search" name="q" placeholder="Your T-Wishlist" autocomplete="off" />
                        <button class="btn btn-cta" type="submit" aria-label="Search" title="Search">🔍</button>
                    </form>
                    <ul class="navbar-nav ms-3 mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item">
                            <button type="button" id="themeToggle" class="btn nav-link theme-toggle-btn" aria-label="Toggle dark mode" title="Toggle dark mode">
                                <span class="theme-icon-light" aria-hidden="true">☀️</span>
                                <span class="theme-icon-dark" aria-hidden="true">🌙</span>
                            </button>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-1" asp-controller="Wishlist" asp-action="Index">
                                    <span class="cart-icon-wrap">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
                                        @await Component.InvokeAsync("WishlistBadge")
                                    </span>
                                    Wishlist
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1" asp-controller="Cart" asp-action="Index">
                                <span class="cart-icon-wrap">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                    @await Component.InvokeAsync("CartBadge")
                                </span>
                                Cart
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @await Component.InvokeAsync("UserAvatar", new { size = 26 })
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end user-menu-dropdown" aria-labelledby="userMenu">
                                    <li class="px-3 py-2 d-flex align-items-center gap-2">
                                        @await Component.InvokeAsync("UserAvatar", new { size = 44 })
                                        <div class="text-truncate">
                                            <div class="fw-semibold text-truncate">@User.Identity.Name</div>
                                            <div class="small text-muted text-truncate">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ManageAccount">Manage my account&hellip;</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="EditProfile">Preferences</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Sign out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container py-4">
            <div class="d-flex flex-column flex-md-row justify-content-md-center footer-cols-gap text-center text-md-start">
                <div>
                    <h4 class="text-nowrap">Your Online Computer Store</h4>
                    <p class="text-muted text-nowrap">
                        Modern AI‑Enhanced Store Built on ASP.NET Core.
                    </p>
                </div>
                <div>
                    <h4>Shop</h4>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Shop" asp-action="Index">All Products</a></li>
                        <li><a asp-controller="Orders" asp-action="Track">Track an Order</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">My Cart</a></li>
                        <li><a asp-controller="Wishlist" asp-action="Index">Wishlist</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Company</h4>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link p-0">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li><a asp-controller="Account" asp-action="Login">Login</a></li>
                            <li><a asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
            <hr class="border-secondary" />
            <p class="text-muted small mb-0 text-center">&copy; @DateTime.Now.Year Online Computer Store, Happily Powered and Mastered by The Good Boys!</p>
        </div>
    </footer>
    @await Html.PartialAsync("_AssistantWidget")

    @* Click-to-enlarge overlay for any profile photo (data-avatar-lightbox) —
       one shared overlay for the whole site, opened by site.js. Hidden by
       default via the [hidden] attribute. *@
    <div id="avatarLightbox" class="avatar-lightbox" hidden>
        <button type="button" class="avatar-lightbox-close" aria-label="Close">&times;</button>
        <img id="avatarLightboxImg" src="" alt="Profile photo" />
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/assistant.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>