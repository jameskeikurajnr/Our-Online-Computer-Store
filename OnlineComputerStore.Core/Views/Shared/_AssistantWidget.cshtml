<div id="assistant-widget">
    <button id="assistant-button" type="button" aria-label="Open AI assistant">💬</button>
    <div id="assistant-panel" role="dialog" aria-label="AI shopping assistant">
        <div class="assistant-header">
            <div>
                <div class="assistant-title">Store Assistant</div>
                <div class="assistant-subtitle">Knows our full catalog &middot; ask anything</div>
            </div>
            <button id="assistant-close" type="button" aria-label="Close">&times;</button>
        </div>
        <div id="assistant-messages">
            <div class="msg ai">Hi! I know everything in our catalog — ask me to find something, compare items, or check what's in stock.</div>
            <div id="assistant-chip-row" class="chip-row">
                <button type="button" class="chip" data-prompt="What gaming keyboards do you have?">Gaming keyboards</button>
                <button type="button" class="chip" data-prompt="What's on sale right now?">What's on sale?</button>
                <button type="button" class="chip" data-prompt="What's the best laptop for university?">Best laptop for uni</button>
            </div>
        </div>
        <div class="assistant-input-row">
            <input id="assistant-input" type="text" placeholder="Ask me anything…" />
            <button id="assistant-send" type="button">Send</button>
        </div>
    </div>
</div>
