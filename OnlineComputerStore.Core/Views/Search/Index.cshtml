@model IEnumerable<Product>
@{
    ViewData["Title"] = "Search";
}
<div class="container my-5">
    <h1 class="section-title">Search Results for "@ViewBag.Query"</h1>
    <p class="ai-panel small">🤖 @ViewBag.AiInterpretation</p>

    @if (!Model.Any())
    {
        <p class="text-muted">No products matched your search. Our team will look into carrying it — Check back soon!</p>
    }
    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-md-3">
                <div class="card product-card h-100">
                    <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name" />
                    <div class="card-body d-flex flex-column">
                        <h6>@p.Name</h6>
                        <p class="text-muted small">@p.ShortSpecs</p>
                        <p class="fw-bold mt-auto">@p.Price.ToMoney()</p>
                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@p.Id" class="btn btn-primary btn-sm">View</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
